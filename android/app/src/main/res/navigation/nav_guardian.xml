<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guardian_graph"
    app:startDestination="@id/guardianHomeFragment">

    <fragment
        android:id="@+id/guardianHomeFragment"
        android:name="id.sch.santaagnes.sim.ui.home.HomeFragment">

        <argument
            android:name="role"
            android:defaultValue="GUARDIAN"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/guardianGradeReportFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.GradeReportFragment">

        <argument
            android:name="role"
            android:defaultValue="GUARDIAN"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/guardianLeaveFragment"
        android:name="id.sch.santaagnes.sim.ui.leave.LeaveFragment" />
</navigation>
