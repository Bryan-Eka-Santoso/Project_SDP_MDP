<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guardian_graph"
    app:startDestination="@id/guardianHomeFragment">

    <fragment
        android:id="@+id/guardianRiwayatPelanggaranFragment"
        android:name="id.sch.santaagnes.sim.ui.pelanggaran.RiwayatPelanggaranFragment"
        android:label="Riwayat Pelanggaran Anak" />

    <fragment
        android:id="@+id/guardianHomeFragment"
        android:name="id.sch.santaagnes.sim.ui.home.HomeFragment">

        <argument
            android:name="role"
            android:defaultValue="GUARDIAN"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/guardianLeaveFragment"
        android:name="id.sch.santaagnes.sim.ui.leave.LeaveFragment" />

    <fragment
        android:id="@+id/guardianScheduleFragment"
        android:name="id.sch.santaagnes.sim.ui.schedule.ScheduleListFragment" />

    <fragment
        android:id="@+id/guardianGradesFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.GradeReportFragment">

        <argument
            android:name="role"
            android:defaultValue="GUARDIAN"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/guardianNotificationsFragment"
        android:name="id.sch.santaagnes.sim.ui.notification.NotificationListFragment" />

    <fragment
        android:id="@+id/guardianProfileFragment"
        android:name="id.sch.santaagnes.sim.ui.profile.ProfileFragment" />

    <fragment
        android:id="@+id/guardianBacaBukuPenghubungFragment"
        android:name="id.sch.santaagnes.sim.ui.bukupenghubung.BacaBukuPenghubungFragment"
        android:label="Buku Penghubung Anak" />
</navigation>
