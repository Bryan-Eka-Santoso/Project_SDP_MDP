<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/teacher_graph"
    app:startDestination="@id/teacherScheduleFragment">

    <fragment
        android:id="@+id/teacherHomeFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.TeacherDashboardFragment">
        android:name="id.sch.santaagnes.sim.ui.home.ComingSoonFragment">

        <argument
            android:name="titleRes"
            android:defaultValue="@string/tab_home"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/teacherClassesFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.TeacherClassesFragment"
        android:label="Kelas Guru" />

    <fragment
        android:id="@+id/gradeManageFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.GradeManageFragment"
        android:label="Nilai Siswa">

        <argument
            android:name="assignmentId"
            app:argType="integer" />

        <argument
            android:name="assignmentLabel"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/teacherGradeReportFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.GradeReportFragment">

        <argument
            android:name="role"
            android:defaultValue="TEACHER"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="id.sch.santaagnes.sim.ui.attendance.AttendanceFragment">

        <argument
            android:name="assignmentId"
            app:argType="integer" />

        <argument
            android:name="assignmentLabel"
            app:argType="string" />
    </fragment>

        android:id="@+id/teacherScheduleFragment"
        android:name="id.sch.santaagnes.sim.ui.schedule.ScheduleListFragment">

        <action
            android:id="@+id/action_schedule_to_taskForm"
            app:destination="@id/teacherTaskFormFragment" />

        <action
            android:id="@+id/action_schedule_to_taskList"
            app:destination="@id/teacherTaskListFragment" />
    </fragment>

    <fragment
        android:id="@+id/teacherTaskListFragment"
        android:name="id.sch.santaagnes.sim.ui.task.TeacherTaskListFragment">

        <action
            android:id="@+id/action_taskList_to_taskForm"
            app:destination="@id/teacherTaskFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/teacherTaskFormFragment"
        android:name="id.sch.santaagnes.sim.ui.task.TeacherTaskFormFragment">

        <argument
            android:name="taskId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="description"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="dueDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="label"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/teacherClassesFragment"
        android:name="id.sch.santaagnes.sim.ui.home.ComingSoonFragment">

        <argument
            android:name="titleRes"
            android:defaultValue="@string/tab_classes"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/teacherNotificationsFragment"
        android:name="id.sch.santaagnes.sim.ui.notification.NotificationListFragment" />

    <fragment
        android:id="@+id/teacherProfileFragment"
        android:name="id.sch.santaagnes.sim.ui.profile.ProfileFragment" />
</navigation>
