<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/teacher_graph"
    app:startDestination="@id/teacherHomeFragment">

    <fragment
        android:id="@+id/teacherHomeFragment"
        android:name="id.sch.santaagnes.sim.ui.home.HomeFragment">

        <argument
            android:name="role"
            android:defaultValue="TEACHER"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/teacherClassesFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.TeacherClassesFragment"
        android:label="Kelas Guru" />

    <fragment
        android:id="@+id/gradeManageFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.GradeManageFragment"
        android:label="Nilai Siswa">

        <argument
            android:name="assignmentId"
            app:argType="integer" />

        <argument
            android:name="assignmentLabel"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/teacherGradeReportFragment"
        android:name="id.sch.santaagnes.sim.ui.grades.GradeReportFragment">

        <argument
            android:name="role"
            android:defaultValue="TEACHER"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="id.sch.santaagnes.sim.ui.attendance.AttendanceFragment">

        <argument
            android:name="assignmentId"
            app:argType="integer" />

        <argument
            android:name="assignmentLabel"
            app:argType="string" />
    </fragment>

</navigation>
