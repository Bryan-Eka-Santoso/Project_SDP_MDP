<?xml version="1.0" encoding="utf-8"?>
<!--
    Graph admin. Lima tab bottom nav (menu_bottom_admin.xml): Home (dashboard), Jadwal, Akademik
    (manajemen pengguna dan siswa), Notifikasi, Profil. Master data lain dibuka dari kartu di dashboard:
    Manajemen -> tab Akademik, Operasional -> adminOperationsFragment, Pembayaran dan Laporan -> aksi global.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/admin_graph"
    app:startDestination="@id/adminDashboardFragment">

    <!-- Dashboard Admin (Figma 144:5468, Home Tab Admin) -->
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.dashboard.AdminDashboardFragment">

        <action
            android:id="@+id/action_adminDashboard_to_adminUser"
            app:destination="@id/adminUserFragment" />

        <action
            android:id="@+id/action_adminDashboard_to_adminSchedule"
            app:destination="@id/adminScheduleFragment" />

        <action
            android:id="@+id/action_adminDashboard_to_operations"
            app:destination="@id/adminOperationsFragment" />

        <action
            android:id="@+id/action_adminDashboard_to_academicYear"
            app:destination="@id/adminAcademicYearFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminOperationsFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.operations.AdminOperationsFragment">

        <action
            android:id="@+id/action_adminOperations_to_subjects"
            app:destination="@id/adminMataPelajaranFragment" />

        <action
            android:id="@+id/action_adminOperations_to_subjectPackages"
            app:destination="@id/adminSubjectPackageFragment" />

        <action
            android:id="@+id/action_adminOperations_to_facilities"
            app:destination="@id/adminFasilitasFragment" />

        <action
            android:id="@+id/action_adminOperations_to_violationTypes"
            app:destination="@id/adminJenisPelanggaranFragment" />

        <action
            android:id="@+id/action_adminOperations_to_bookings"
            app:destination="@id/adminPeminjamanFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminScheduleFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.schedule.AdminScheduleFragment">

        <action
            android:id="@+id/action_adminSchedule_to_slotForm"
            app:destination="@id/slotFormFragment" />

        <action
            android:id="@+id/action_adminSchedule_to_import"
            app:destination="@id/scheduleImportFragment" />

        <action
            android:id="@+id/action_adminSchedule_to_changeList"
            app:destination="@id/changeListFragment" />
    </fragment>

    <fragment
        android:id="@+id/slotFormFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.schedule.SlotFormFragment">

        <argument
            android:name="slotId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="assignmentId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="roomId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="dayOfWeek"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="startTime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="endTime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/scheduleImportFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.schedule.ScheduleImportFragment" />

    <fragment
        android:id="@+id/changeListFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.schedule.ChangeListFragment">

        <action
            android:id="@+id/action_changeList_to_changeForm"
            app:destination="@id/changeFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/changeFormFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.schedule.ChangeFormFragment">

        <argument
            android:name="slotId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="date"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="type"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="description"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="substituteTeacherId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="newRoomId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="newStartTime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="newEndTime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/adminNotificationsFragment"
        android:name="id.sch.santaagnes.sim.ui.notification.NotificationListFragment" />

    <fragment
        android:id="@+id/adminProfileFragment"
        android:name="id.sch.santaagnes.sim.ui.profile.ProfileFragment" />

    <!-- Master Data (F-MST, milik Yosua) -->
    <fragment
        android:id="@+id/adminUserFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.users.AdminUserFragment">

        <action
            android:id="@+id/action_adminUser_to_adminStudent"
            app:destination="@id/adminStudentFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminStudentFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.students.AdminStudentFragment">

        <action
            android:id="@+id/action_adminStudent_to_adminUser"
            app:destination="@id/adminUserFragment" />

        <action
            android:id="@+id/action_adminStudent_to_import"
            app:destination="@id/masterImportFragment">
            <argument
                android:name="importType"
                android:defaultValue="STUDENT"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/adminTeacherFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.teachers.AdminTeacherFragment">

        <action
            android:id="@+id/action_adminTeacher_to_import"
            app:destination="@id/masterImportFragment">
            <argument
                android:name="importType"
                android:defaultValue="TEACHER"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/masterImportFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.MasterImportFragment">
        <argument
            android:name="importType"
            android:defaultValue="STUDENT"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminClassFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.classes.AdminClassFragment" />

    <fragment
        android:id="@+id/adminAcademicYearFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.periods.AdminAcademicYearFragment">

        <action
            android:id="@+id/action_adminAcademicYear_to_gradePredicate"
            app:destination="@id/gradePredicateFragment" />
    </fragment>

    <fragment
        android:id="@+id/gradePredicateFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.master.periods.GradePredicateFragment">
        <argument
            android:name="academicYearId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="academicYearName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminMataPelajaranFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.matapelajaran.MataPelajaranFragment"
        android:label="Master Mata Pelajaran" />

    <fragment
        android:id="@+id/adminSubjectPackageFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.elective.SubjectPackageFragment"
        android:label="Paket Mata Pelajaran Pilihan" />

    <fragment
        android:id="@+id/adminFasilitasFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.fasilitas.FasilitasFragment"
        android:label="Master Fasilitas" />

    <fragment
        android:id="@+id/adminJenisPelanggaranFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.jenispelanggaran.JenisPelanggaranFragment"
        android:label="Master Jenis Pelanggaran" />

    <fragment
        android:id="@+id/adminPeminjamanFragment"
        android:name="id.sch.santaagnes.sim.ui.admin.peminjaman.PeminjamanFragment"
        android:label="Persetujuan Peminjaman" />
</navigation>
