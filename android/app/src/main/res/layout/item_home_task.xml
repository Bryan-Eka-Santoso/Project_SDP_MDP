<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/agnesian_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Latihan Bab 3" />

    <TextView
        android:id="@+id/tvSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/agnesian_muted"
        android:textSize="12sp"
        tools:text="Matematika" />

    <TextView
        android:id="@+id/tvDue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/agnesian_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Tenggat: Jumat, 20 November 2026 pukul 14:30 · Waktu sisa 5 hari" />
</LinearLayout>
