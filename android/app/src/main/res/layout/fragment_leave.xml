<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F2F2F2">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#2354C5">
        <View android:layout_width="106dp" android:layout_height="106dp" android:layout_gravity="top|right"
            android:layout_marginTop="-26dp" android:layout_marginRight="-23dp"
            android:background="@drawable/bg_teacher_header_circle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="18dp" android:paddingBottom="25dp">
            <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/back_previous" android:drawableStart="@drawable/ic_arrow_back" android:drawablePadding="8dp" android:minHeight="44dp" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="15sp" android:paddingVertical="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Pengajuan Absensi" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="23sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="Ajukan izin ketidakhadiran siswa" android:textColor="#EAF0FF" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
            <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_leave_card" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Form Pengajuan Izin" android:textColor="#17284B" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Nama Siswa" android:textSize="12sp" android:textColor="#556278" />
                <Spinner android:id="@+id/spinnerChild" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_leave_field" android:paddingHorizontal="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Tanggal mulai izin" android:textSize="12sp" android:textColor="#556278" />
                <TextView android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_leave_field" android:padding="13dp" android:gravity="center_vertical" android:textColor="#26354D" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Tanggal selesai izin" android:textSize="12sp" android:textColor="#556278" />
                <TextView android:id="@+id/btnEnd" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_leave_field" android:padding="13dp" android:gravity="center_vertical" android:textColor="#26354D" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Alasan Izin" android:textSize="12sp" android:textColor="#556278" />
                <EditText android:id="@+id/etReason" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="5dp" android:background="@drawable/bg_leave_field" android:padding="12dp" android:gravity="top" android:hint="Tuliskan alasan izin (minimal 5 karakter)" android:textSize="14sp" android:inputType="textMultiLine" android:maxLength="255" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Bukti / Lampiran (opsional)" android:textSize="12sp" android:textColor="#556278" />
                <TextView android:id="@+id/btnAttach" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/bg_leave_field" android:text="＋ Pilih foto atau PDF" android:textColor="#245BCB" android:textSize="14sp" />
                <TextView android:id="@+id/tvAttachment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Format JPG, PNG, PDF · Maksimal 5 MB" android:textColor="#7A8495" android:textSize="11sp" />
                <TextView android:id="@+id/btnRemoveAttachment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="6dp" android:text="Hapus lampiran" android:textColor="#BB3B3B" android:textSize="12sp" android:visibility="gone" />
                <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:backgroundTint="#2A62D8" android:text="Ajukan Absensi" android:textAllCaps="false" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/tvFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#1C7549" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="24dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Riwayat Pengajuan Izin" android:textColor="#17284B" android:textStyle="bold" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pantau status pengajuan izin siswa" android:textColor="#747E8F" android:textSize="12sp" />
                <TextView android:id="@+id/btnReload" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:background="@drawable/bg_leave_card" android:padding="14dp" android:text="↻ Muat ulang status" android:textColor="#245BCB" android:textStyle="bold" android:textSize="13sp" />
                <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Belum ada pengajuan izin." android:textColor="#747E8F" android:visibility="gone" />
                <LinearLayout android:id="@+id/listRequests" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
