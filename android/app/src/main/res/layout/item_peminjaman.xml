<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvFacility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Laboratorium Komputer" />

        <TextView
            android:id="@+id/tvRequester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pemohon" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tanggal" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waktu" />

        <TextView
            android:id="@+id/tvPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keperluan" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tolak" />

            <Button
                android:id="@+id/btnApprove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setujui" />

        </LinearLayout>

        <!-- TANGGAL PENGEMBALIAN -->
        <TextView
            android:id="@+id/tvReturnDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Dikembalikan pada: -"
            android:textColor="@color/agnesian_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- TOMBOL KONFIRMASI PENGEMBALIAN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="Konfirmasi Kembali"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/agnesian_blue"
            app:cornerRadius="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>