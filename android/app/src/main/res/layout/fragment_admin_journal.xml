<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/agnesian_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_header"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="24dp" android:paddingBottom="30dp">
        <TextView android:id="@+id/btnJournalBack" android:layout_width="wrap_content"
            android:layout_height="44dp" android:gravity="center_vertical"
            android:clickable="true" android:focusable="true"
            android:text="‹ Kembali ke Halaman Sebelumnya" android:textSize="12sp"
            android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Monitoring Jurnal Mengajar"
            android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Pantau sesi dan catatan mengajar guru"
            android:textColor="@color/white" android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressJournal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="14dp" app:cardBackgroundColor="@color/white" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="14dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Filter tanggal" android:textStyle="bold" android:textSize="14sp"
                        android:textColor="@color/agnesian_text" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnJournalStart" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Dari tanggal" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnJournalEnd" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="8dp" android:text="Sampai tanggal" android:textSize="11sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJournalClear" style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hapus filter" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvJournalTotal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" android:text="0 sesi jurnal mengajar"
                android:textStyle="bold" android:textColor="@color/agnesian_text" android:textSize="15sp" />
            <TextView android:id="@+id/tvJournalError" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/change_cancel"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJournalRetry" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Coba lagi" android:visibility="gone" />
            <TextView android:id="@+id/tvJournalEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Tidak ada jurnal mengajar pada rentang tanggal ini."
                android:textColor="@color/agnesian_muted" android:textSize="14sp"
                android:padding="16dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/journalList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJournalMore" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Muat lebih banyak"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
