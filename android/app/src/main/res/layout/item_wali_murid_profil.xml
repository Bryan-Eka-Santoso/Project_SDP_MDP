<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_wali_murid_profil"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvNamaWali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Wali Murid"
        android:textColor="@color/agnesian_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHubunganWali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Hubungan: -"
        android:textColor="@color/agnesian_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvTeleponWali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Telepon: -"
        android:textColor="@color/agnesian_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvEmailWali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Email: -"
        android:textColor="@color/agnesian_text"
        android:textSize="12sp" />
</LinearLayout>
