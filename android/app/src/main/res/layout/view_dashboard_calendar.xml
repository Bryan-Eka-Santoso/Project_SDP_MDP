<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Baris Judul Kartu & Tombol Kelola / Detail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_calendar"
                android:textColor="@color/agnesian_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOpenFullCalendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/agnesian_button"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Kelola" />
        </LinearLayout>

        <!-- Navigasi Bulan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="Bulan sebelumnya"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/agnesian_text" />

            <TextView
                android:id="@+id/tvMonthTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/agnesian_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="November 2026" />

            <TextView
                android:id="@+id/btnToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_option_selected"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="Hari Ini"
                android:textColor="@color/agnesian_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="Bulan berikutnya"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/agnesian_text" />
        </LinearLayout>

        <!-- Header Hari (Sen–Min) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="7">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sen"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sel"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Rab"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Kam"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Jum"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sab"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Min"
                android:textColor="@color/change_cancel"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendarDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Legenda Warna -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_calendar_dot"
                android:backgroundTint="@color/change_substitute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="14dp"
                android:text="Ujian"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_calendar_dot"
                android:backgroundTint="@color/bill_paid" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="14dp"
                android:text="Libur"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_calendar_dot"
                android:backgroundTint="@color/agnesian_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Kegiatan"
                android:textColor="@color/agnesian_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/agnesian_divider" />

        <TextView
            android:id="@+id/tvAgendaSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/agnesian_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Agenda November 2026" />

        <LinearLayout
            android:id="@+id/agendaList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvAgendaEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calendar_empty"
            android:textColor="@color/agnesian_muted"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
