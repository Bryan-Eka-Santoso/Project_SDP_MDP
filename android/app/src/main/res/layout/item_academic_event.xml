<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_role"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/agnesian_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Ujian" />

            <TextView
                android:id="@+id/tvDateRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/agnesian_muted"
                android:textSize="12sp"
                tools:text="21 Sep 2026 – 26 Sep 2026" />

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="@string/action_edit"
                android:padding="5dp"
                android:src="@drawable/ic_edit"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="@string/action_delete"
                android:padding="5dp"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="@color/black" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/agnesian_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Penilaian Tengah Semester Ganjil" />

        <TextView
            android:id="@+id/tvEventDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/agnesian_muted"
            android:textSize="13sp"
            tools:text="Seluruh siswa wajib membawa kartu peserta ujian." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToDeviceCalendar"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/calendar_save_to_device"
            android:textAllCaps="false"
            android:textColor="@color/agnesian_blue"
            android:textSize="12sp"
            app:backgroundTint="@color/agnesian_tile"
            app:cornerRadius="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
