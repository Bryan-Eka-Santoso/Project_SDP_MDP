<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/bg_teacher_card"
    android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/tvRecapName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/agnesian_text" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvRecapCounts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/agnesian_blue" android:textSize="13sp" />
</LinearLayout>
