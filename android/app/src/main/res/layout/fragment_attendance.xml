<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/teacher_screen">

    <!-- Header Halaman Absensi -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="164dp"
        android:background="@drawable/bg_teacher_header"
        android:clipChildren="true">

        <View
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="top|end"
            android:translationX="38dp"
            android:translationY="-34dp"
            android:background="@drawable/bg_teacher_header_circle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:text="‹ Kembali ke Halaman Kelas"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Absensi Siswa"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#EDF3FF"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Konten Halaman -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Pemilihan Sesi Mengajar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_teacher_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilih Sesi Mengajar"
                    android:textSize="12sp"
                    android:textColor="@color/teacher_muted" />

                <Spinner
                    android:id="@+id/spinnerSlots"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_teacher_field" />

                <Button
                    android:id="@+id/btnDate"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="12dp"
                    android:text="Pilih Tanggal"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/teacher_blue_light" />

            </LinearLayout>

            <!-- Loading dan Feedback -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="#B42318" />

            <!-- Card Jurnal Mengajar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_teacher_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jurnal Mengajar / Materi"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/teacher_ink" />

                <EditText
                    android:id="@+id/etJournal"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="11dp"
                    android:hint="Materi yang diajarkan pada sesi ini"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:gravity="top"
                    android:maxLength="255"
                    android:inputType="textCapSentences|textMultiLine"
                    android:background="@drawable/bg_teacher_field" />

            </LinearLayout>

            <!-- Card Daftar Siswa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_teacher_card">

                <TextView
                    android:id="@+id/tvCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daftar Siswa"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/teacher_ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilih status Hadir, Sakit, Izin, atau Alpa untuk setiap siswa"
                    android:layout_marginTop="5dp"
                    android:textSize="11sp"
                    android:textColor="@color/teacher_muted" />

                <!-- Tombol Baru: Tandai Semua Hadir -->
                <Button
                    android:id="@+id/btnMarkAllPresent"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Tandai Semua Hadir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/teacher_blue_light" />

                <!-- Container Daftar Siswa -->
                <LinearLayout
                    android:id="@+id/studentsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <!-- Tombol Muat Ulang -->
                <Button
                    android:id="@+id/btnReload"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="14dp"
                    android:text="Muat ulang presensi"
                    android:textAllCaps="false"
                    android:textColor="@color/teacher_blue"
                    android:backgroundTint="#E3EAFB" />

            </LinearLayout>

            <!-- Tombol Simpan Absensi -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginTop="16dp"
                android:text="Simpan Absensi dan Jurnal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/teacher_blue_light" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Guru -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_teacher_bottom_nav" />

</LinearLayout>
