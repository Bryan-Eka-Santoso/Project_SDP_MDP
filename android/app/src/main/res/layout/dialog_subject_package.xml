<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutAcademicYear"
        style="@style/Widget.Agnesian.SelectorInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tahun Ajaran">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAcademicYearSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:inputType="none"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutPackageName"
        style="@style/Widget.Agnesian.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nama Paket (mis. Paket MIPA Lanjut)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLength="100"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCapacity"
        style="@style/Widget.Agnesian.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Kapasitas per Kelas (maks. 100)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1"
            tools:text="36" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mata Pelajaran dalam Paket"
            android:textColor="@color/agnesian_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedSubjectsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/agnesian_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="2 dipilih" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSubjectSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_box"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:hint="Cari kode atau nama mapel"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/agnesian_text"
        android:textColorHint="@color/agnesian_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSubjectsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tidak ada mata pelajaran yang cocok."
        android:textColor="@color/agnesian_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/containerSubjectChecklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
</LinearLayout>
