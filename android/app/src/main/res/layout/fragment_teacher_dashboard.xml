<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/teacher_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Dashboard Guru -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_teacher_header"
                android:clipChildren="true">

                <!-- Dekorasi lingkaran biru -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="top|end"
                    android:translationX="42dp"
                    android:translationY="-48dp"
                    android:background="@drawable/bg_teacher_header_circle" />

                <!-- Informasi Guru -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selamat datang,"
                        android:textColor="#E1EBFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTeacherName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Guru SMA Santa Agnes"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <!-- Konten Kelas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="22dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kelas yang Diajar"
                    android:textSize="17sp"
                    android:textColor="@color/teacher_ink"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pilih kelas untuk melihat Nilai dan Absensi"
                    android:textSize="12sp"
                    android:textColor="@color/teacher_muted" />

                <!-- Loading -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="12dp"
                    android:visibility="gone" />

                <!-- Status atau pesan error -->
                <TextView
                    android:id="@+id/tvHomeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#B42318" />

                <!-- Daftar Kelas Guru -->
                <LinearLayout
                    android:id="@+id/classesPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Tombol Semua Kelas -->
                <Button
                    android:id="@+id/btnAllClasses"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:text="Lihat Semua Kelas"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/teacher_blue_light" />

                <!-- Tombol Rekap Nilai -->
                <Button
                    android:id="@+id/btnGradeReport"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_marginTop="9dp"
                    android:text="Rekap Nilai Kelas"
                    android:textAllCaps="false"
                    android:textColor="@color/teacher_blue"
                    android:backgroundTint="#E2EAFB" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_teacher_bottom_nav" />

</LinearLayout>
