<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/agnesian_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                app:tint="@color/agnesian_blue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calendar_sync_title"
                android:textColor="@color/agnesian_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCalendarSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/calendar_sync_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCalendarSyncDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/agnesian_muted"
            android:textSize="12sp"
            tools:text="Agenda kalender akademik tersinkron otomatis ke Google Calendar di perangkat Anda." />

        <TextView
            android:id="@+id/btnSelectGoogleAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_option_selected"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:textColor="@color/agnesian_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Akun Google: siswa@gmail.com"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCalendarSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/agnesian_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Terakhir sinkron 13:30 WIB · 5 agenda di Google Calendar"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutSyncActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncNow"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/calendar_sync_now"
                android:textAllCaps="false"
                android:textColor="@color/agnesian_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="@color/agnesian_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGoogleCalendar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/calendar_open_google"
                android:textAllCaps="false"
                android:textColor="@color/agnesian_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/agnesian_tile"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
