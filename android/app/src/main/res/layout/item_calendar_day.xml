<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_margin="2dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/agnesian_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="19" />

    <LinearLayout
        android:id="@+id/dotContainer"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotExam"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1.5dp"
            android:background="@drawable/bg_calendar_dot"
            android:backgroundTint="@color/change_substitute"
            android:visibility="gone" />

        <View
            android:id="@+id/dotHoliday"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1.5dp"
            android:background="@drawable/bg_calendar_dot"
            android:backgroundTint="@color/bill_paid"
            android:visibility="gone" />

        <View
            android:id="@+id/dotActivity"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1.5dp"
            android:background="@drawable/bg_calendar_dot"
            android:backgroundTint="@color/agnesian_blue"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
