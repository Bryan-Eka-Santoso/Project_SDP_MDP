<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#FFFFFF"
    android:padding="16dp" android:orientation="vertical">
    <TextView android:id="@+id/tvStudentName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="15sp" android:textColor="#24314B" />
    <TextView android:id="@+id/tvStudentScores" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#3D61B5" />
    <Button android:id="@+id/btnEditScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ubah Nilai" android:textAllCaps="false" android:backgroundTint="#245CCB" />
</LinearLayout>
