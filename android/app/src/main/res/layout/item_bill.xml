<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hanya pada daftar lintas siswa (admin dan wali kelas). -->
        <TextView
            android:id="@+id/tvStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/agnesian_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Siswa Satu · 2026001 · X-1"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/agnesian_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="SPP November" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/white"
                tools:text="Menunggak" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/agnesian_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Rp 850.000" />

        <TextView
            android:id="@+id/tvDue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/agnesian_muted"
            android:textSize="13sp"
            tools:text="Jatuh tempo: Minggu, 15 November 2026" />

        <TextView
            android:id="@+id/tvCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/agnesian_muted"
            android:textSize="12sp"
            tools:text="Kode: SPP-2026-11" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
