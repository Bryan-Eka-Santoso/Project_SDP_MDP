# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Koneksi MySQL untuk Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sim_santa_agnes"

# Port API
PORT=3000

# Kunci tanda tangan access token JWT, minimal 32 karakter acak. Contoh membuatnya:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Masa berlaku token (angka + satuan s/m/h/d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Upload file ke Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Path file kredensial Firebase Admin SDK (jangan commit file JSON-nya)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Zona waktu untuk perhitungan tanggal lokal
TZ_DISPLAY=Asia/Jakarta

# Seeder (npx prisma db seed). Password minimal 8 karakter.
SEED_ADMIN_EMAIL=admin@santaagnes.test
SEED_ADMIN_PASSWORD=
# Password semua akun demo (guruN/siswaN/waliN@santaagnes.test)
SEED_DEMO_PASSWORD=
# Isi false untuk server produksi agar akun demo tidak dibuat
SEED_DEMO_DATA=true
