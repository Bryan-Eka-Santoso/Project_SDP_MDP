# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Koneksi MySQL untuk Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sim_santa_agnes"

# Port API
PORT=3000

# Kunci tanda tangan JWT (isi dengan string acak panjang, berbeda satu sama lain)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Masa berlaku token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Upload file ke Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Path file kredensial Firebase Admin SDK (jangan commit file JSON-nya)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Zona waktu untuk perhitungan tanggal lokal
TZ_DISPLAY=Asia/Jakarta
